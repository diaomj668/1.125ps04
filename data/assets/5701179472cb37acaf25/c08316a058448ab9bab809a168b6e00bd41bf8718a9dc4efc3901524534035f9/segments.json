  },
  {
    "segment_id": "s00017",
    "start_seconds": 32.88,
    "end_seconds": 36.080000000000005,
    "text": "before channels like Mr. Beast and"
  },
  {
    "segment_id": "s00018",
    "start_seconds": 34.6,
    "end_seconds": 37.96,
    "text": "Fireship came in to unshitify the"
  },
  {
    "segment_id": "s00019",
    "start_seconds": 36.08,
    "end_seconds": 40.0,
    "text": "platform. In today's video, we'll find"
  },
  {
    "segment_id": "s00020",
    "start_seconds": 37.96,
    "end_seconds": 41.6,
    "text": "out what Ajax really is under the hood,"
  },
  {
    "segment_id": "s00021",
    "start_seconds": 40.0,
